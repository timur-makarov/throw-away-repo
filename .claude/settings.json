{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Write(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./**/.env.local)",
      "Write(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Write(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Edit(./**/.env.development)",
      "Write(./**/.env.development)",
      "Read(./**/.env.production)",
      "Edit(./**/.env.production)",
      "Write(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Edit(./**/.env.staging)",
      "Write(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Edit(./**/.env.test)",
      "Write(./**/.env.test)",
      "Edit(./.rail/journal/**)",
      "Write(./.rail/journal/**)"
    ],
    "ask": [
      "Bash(rail answer * --owner)",
      "Bash(rail answer * --owner *)",
      "Bash(rail answer --owner *)"
    ],
    "allow": [
      "Bash(rail next *)",
      "Bash(rail advance *)",
      "Bash(rail add *)",
      "Bash(rail answer *)",
      "Bash(rail amend *)",
      "Bash(rail status *)",
      "Bash(rail context *)",
      "Bash(rail docs *)",
      "Bash(rail doctor *)",
      "Bash(rail intake *)",
      "Bash(rail sweep *)",
      "Bash(rail consult *)",
      "Bash(gh run watch *)",
      "Bash(rail save *)",
      "Bash(rail provision *)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "7200000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.rail/bin/rail hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.rail/bin/rail hook guard"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.rail/bin/rail hook notify"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(find \"$HOME/.cache/rail/pulse/${CLAUDE_CODE_SESSION_ID:-any}\" -mmin -10 2>/dev/null)\" ] || \"$CLAUDE_PROJECT_DIR\"/.rail/bin/rail hook pulse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.rail/bin/rail hook stop"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true
  }
}
